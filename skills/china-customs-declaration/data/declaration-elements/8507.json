      "order": 2,
      "required": true,
      "aliases": ["出口享惠情况"],
      "source_keys": ["export_preference"],
      "validation": {
        "type": "enum",
        "values": ["1-出口货物在最终目的国可享受优惠关税", "2-出口货物在最终目的国不享受优惠关税", "3-出口货物不能确定在最终目的国享受优惠关税", "9-不适用内销货物"],
        "note": "照实填报"
      }
